import { useState, useEffect, useCallback } from 'react';
import { TelegramUserInfo } from '../types/music';

export interface TelegramWebApp {
  ready: () => void;
  expand: () => void;
  close: () => void;
  initData: string;
  initDataUnsafe?: {
    user?: {
      id: number;
      first_name: string;
      last_name?: string;
      username?: string;
      language_code?: string;
      is_premium?: boolean;
      photo_url?: string;
    };
    query_id?: string;
    chat?: any;
  };
  themeParams?: {
    bg_color?: string;
    text_color?: string;
    hint_color?: string;
    link_color?: string;
    button_color?: string;
    button_text_color?: string;
    secondary_bg_color?: string;
  };
  colorScheme?: 'light' | 'dark';
  isExpanded?: boolean;
  viewportHeight?: number;
  viewportStableHeight?: number;
  headerColor?: string;
  backgroundColor?: string;
  sendData: (data: string) => void;
  HapticFeedback?: {
    impactOccurred: (style: 'light' | 'medium' | 'heavy' | 'rigid' | 'soft') => void;
    notificationOccurred: (type: 'error' | 'success' | 'warning') => void;
    selectionChanged: () => void;
  };
  showAlert: (message: string, callback?: () => void) => void;
  showConfirm: (message: string, callback?: (confirmed: boolean) => void) => void;
  openLink: (url: string) => void;
  openTelegramLink: (url: string) => void;
}

declare global {
  interface Window {
    Telegram?: {
      WebApp?: TelegramWebApp;
    };
  }
}

export function useTelegram() {
  const [tg, setTg] = useState<TelegramWebApp | null>(() => {
    if (typeof window !== 'undefined') {
      return window.Telegram?.WebApp || null;
    }
    return null;
  });

  const [user, setUser] = useState<TelegramUserInfo>(() => {
    if (typeof window !== 'undefined') {
      const tgUser = window.Telegram?.WebApp?.initDataUnsafe?.user;
      if (tgUser && tgUser.id) {
        return {
          id: tgUser.id,
          first_name: tgUser.first_name,
          last_name: tgUser.last_name,
          username: tgUser.username,
          language_code: tgUser.language_code,
          is_premium: tgUser.is_premium,
          photo_url: tgUser.photo_url,
        };
      }
      const savedAuth = localStorage.getItem('tg_auth_user');
      if (savedAuth) {
        try {
          const parsed = JSON.parse(savedAuth);
          if (parsed && parsed.id) return parsed;
        } catch {}
      }
    }
    return {
      id: 10001,
      first_name: 'Пользователь',
      username: 'tg_music_fan',
    };
  });

  const [isInsideTelegram, setIsInsideTelegram] = useState<boolean>(() => {
    if (typeof window !== 'undefined') {
      const tgWeb = window.Telegram?.WebApp;
      if (tgWeb && (Boolean(tgWeb.initData) || Boolean(tgWeb.initDataUnsafe?.user?.id))) {
        return true;
      }
    }
    return false;
  });

  const [colorScheme, setColorScheme] = useState<'light' | 'dark'>('dark');

  useEffect(() => {
    const webApp = window.Telegram?.WebApp;
    if (webApp) {
      setTg(webApp);
      try {
        webApp.ready();
        webApp.expand();
      } catch (e) {
        console.warn('Telegram WebApp init warning:', e);
      }

      const tgUser = webApp.initDataUnsafe?.user;
      if (tgUser && tgUser.id) {
        setUser({
          id: tgUser.id,
          first_name: tgUser.first_name,
          last_name: tgUser.last_name,
          username: tgUser.username,
          language_code: tgUser.language_code,
          is_premium: tgUser.is_premium,
          photo_url: tgUser.photo_url,
        });
        setIsInsideTelegram(true);
      } else if (webApp.initData) {
        setIsInsideTelegram(true);
      }

      if (webApp.colorScheme) {
        setColorScheme(webApp.colorScheme);
      }
    }
  }, []);

  const triggerHaptic = useCallback(
    (type: 'light' | 'medium' | 'heavy' | 'success' | 'error' | 'selection' = 'light') => {
      try {
        const haptic = tg?.HapticFeedback;
        if (!haptic) return;

        if (type === 'success' || type === 'error') {
          haptic.notificationOccurred(type);
        } else if (type === 'selection') {
          haptic.selectionChanged();
        } else {
          haptic.impactOccurred(type);
        }
      } catch {
        // Haptics optional
      }
    },
    [tg]
  );

  const sendDataToBot = useCallback(
    (data: any) => {
      triggerHaptic('success');
      if (tg?.sendData) {
        tg.sendData(typeof data === 'string' ? data : JSON.stringify(data));
      }
    },
    [tg, triggerHaptic]
  );

  return {
    tg,
    user,
    setUser,
    isInsideTelegram,
    colorScheme,
    triggerHaptic,
    sendDataToBot,
    chatId: user.id,
  };
}
